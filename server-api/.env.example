# Keep this file private as .env on the API host. Never put this token in app.js.
# Generate a unique value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SIRCARFT_API_TOKEN=replace_with_a_random_32_plus_character_secret
SIRCARFT_DB_PATH=data/sircarft.sqlite3
SIRCARFT_MAX_SERVERS=2
